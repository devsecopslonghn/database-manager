{
  "name": "schemaops-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/migrate.js",
    "start": "node dist/server.js",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "fastify": "5.11.3",
    "jose": "^6.0.11",
    "mssql": "^11.0.1",
    "mysql2": "^3.23.2",
    "oracledb": "^6.10.0",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/pg": "8.15.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
